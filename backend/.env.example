PORT=5000
NODE_ENV=development
USE_HTTPS=false
SSL_KEY_PATH=
SSL_CERT_PATH=

# PostgreSQL Connection settings
PGUSER=postgres
PGHOST=localhost
PGPASSWORD=change_this_to_a_secure_password
PGDATABASE=project_hall
PGPORT=5432

# Session Secret (Required in production, terminated if missing or default)
SESSION_SECRET=change_this_to_a_secure_random_string_in_production

# JWT / OIDC Configuration
JWT_ISSUER=http://localhost:5000
JWT_AUDIENCE=http://localhost:5173

# Frontend URL & Google OAuth
FRONTEND_URL=http://localhost:5173
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
